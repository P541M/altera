{
  "manifest_version": 3,
  "name": "Altera",
  "version": "1.0",
  "description": "Customize your D2L/Courselink UI with themes, images, and more!",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/cog-icon.png",
      "48": "icons/cog-icon.png",
      "128": "icons/cog-icon.png"
    }
  },
  "icons": {
    "128": "icons/cog-icon.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://courselink.uoguelph.ca/*"],
      "run_at": "document_end",
      "css": ["content.css", "darkmode.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/cog-icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
