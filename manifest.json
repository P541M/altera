{
  "manifest_version": 3,
  "name": "Altera for CourseLink",
  "short_name": "Altera",
  "version": "2.0.0",
  "description": "CourseLink, refined.",
  "homepage_url": "https://github.com/P541M/altera",
  "minimum_chrome_version": "111",
  "browser_specific_settings": {
    "gecko": {
      "id": "altera@p541m",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Altera",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://courselink.uoguelph.ca/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-dark-mode": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle dark mode"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://courselink.uoguelph.ca/*"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN",
      "js": [
        "src/content/main-world.js"
      ]
    },
    {
      "matches": [
        "https://courselink.uoguelph.ca/*"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "css": [
        "src/styles/theme.css"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/theme.js"
      ]
    },
    {
      "matches": [
        "https://courselink.uoguelph.ca/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/content/session.js"
      ]
    }
  ]
}
